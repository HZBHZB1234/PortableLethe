{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Portable Lethe Hub",
  "version": "0.1.1",
  "identifier": "com.portablelethe.hub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Portable Lethe Hub",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}

